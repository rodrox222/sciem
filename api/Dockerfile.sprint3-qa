FROM php:8.3-cli
# mbstring y la familia XML ya vienen compiladas en la imagen oficial.
# Recompilar DOM antes de XMLReader elimina cabeceras que necesita XMLReader.
RUN apt-get update && apt-get install -y --no-install-recommends git unzip libpq-dev libzip-dev libpng-dev \
    && docker-php-ext-install pdo_pgsql zip gd bcmath \
    && php -r 'foreach (["pdo_pgsql", "zip", "gd", "bcmath", "mbstring", "dom", "xml", "xmlreader", "xmlwriter", "SimpleXML"] as $extension) { if (!extension_loaded($extension)) { fwrite(STDERR, "Missing PHP extension: $extension\n"); exit(1); } }' \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
