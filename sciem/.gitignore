# ==========================================
# Dependencias y paquetes
# ==========================================
**/node_modules/
**/vendor/

# ==========================================
# Compilados y builds (Vite & Laravel)
# ==========================================
**/dist/
**/build/
gui/dist/
api/public/build/
api/public/hot

# ==========================================
# Variables de entorno y credenciales
# ==========================================
.env
.env.*
!.env.example
!.env.docker.example
api/.env
api/.env.*
!api/.env.example
*.key
auth.json

# ==========================================
# Datos persistentes de Docker y BD
# ==========================================
data/
data/pg_data/
*.sql
*.sqlite

# ==========================================
# Laravel 11 (Caché, logs y storage)
# ==========================================
api/bootstrap/cache/*
!api/bootstrap/cache/.gitignore
api/storage/*.key
api/storage/app/*
!api/storage/app/.gitignore
api/storage/framework/cache/*
!api/storage/framework/cache/.gitignore
api/storage/framework/sessions/*
!api/storage/framework/sessions/.gitignore
api/storage/framework/testing/*
!api/storage/framework/testing/.gitignore
api/storage/framework/views/*
!api/storage/framework/views/.gitignore
api/storage/logs/*
!api/storage/logs/.gitignore
api/storage/pail/
api/public/storage

# ==========================================
# Logs y temporales (Node, NPM, Vite)
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ==========================================
# Editores, IDEs y Sistema Operativo
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
.phpunit.result.cache
.phpactor.json